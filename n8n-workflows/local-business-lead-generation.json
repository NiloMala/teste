      "id": "supabase-insert-node",
      "name": "Salvar no Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1450, 390],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Gera mensagem personalizada para WhatsApp\nconst items = [];\n\nfor (const item of $input.all()) {\n  const empresa = item.json;\n  \n  // Remove caracteres especiais do telefone\n  let telefone = empresa.telefone.replace(/\\D/g, '');\n  \n  // Adiciona código do país se necessário\n  if (!telefone.startsWith('55')) {\n    telefone = '55' + telefone;\n  }\n  \n  // Mensagem personalizada\n  const mensagem = `Olá! 👋\\n\\nMeu nome é [SEU NOME] e trabalho com automação de processos e atendimento via WhatsApp para empresas locais.\\n\\nNotei que ${empresa.nomeEmpresa} é um negócio muito bem avaliado aqui na região! 🌟\\n\\nVocê já pensou em automatizar:\\n✅ Agendamentos\\n✅ Pedidos\\n✅ Atendimento ao cliente\\n✅ Follow-up de vendas\\n\\nPosso te mostrar como isso pode economizar tempo e aumentar suas vendas?\\n\\nTenho cases de sucesso com empresas similares. Posso te enviar alguns exemplos?`;\n  \n  items.push({\n    json: {\n      ...empresa,\n      telefoneFormatado: telefone,\n      mensagem: mensagem,\n      statusEnvio: 'pendente'\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "message-builder-node",
      "name": "Criar Mensagem WhatsApp",
      "type": "n8n-nodes-base.code",
