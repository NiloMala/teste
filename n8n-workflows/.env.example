# Configurações para N8N Workflow - Geração de Leads

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://api.evolutionapi.com
EVOLUTION_INSTANCE=nome-da-sua-instancia
EVOLUTION_API_KEY=sua-chave-api-aqui

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# SerpAPI (opcional mas recomendado)
SERPAPI_KEY=sua-serpapi-key-aqui

# Configurações de Busca
DEFAULT_CIDADE=São Paulo
DEFAULT_ESTADO=SP
DEFAULT_PAIS=Brasil

# Limites de Segurança
MAX_MENSAGENS_POR_DIA=50
INTERVALO_ENTRE_MENSAGENS_SEGUNDOS=10
HORARIO_INICIO=09:00
HORARIO_FIM=18:00

# Configurações de Desenvolvimento
NODE_ENV=production
DEBUG=false
